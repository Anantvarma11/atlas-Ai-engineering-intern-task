# Copy this file to .env and fill in values as needed. Everything in the
# pipeline and API works with no keys at all — these only sharpen the
# handful of genuinely ambiguous hotel-matching cases and unlock the admin
# panel, respectively.

# Optional: enables the LLM adjudication pass (pipeline/llm_adjudicate.py).
# Cerebras is OpenAI-API-compatible; get a free key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional: enables the /admin/* routes used by the admin panel (upload
# supplier files, trigger a pipeline re-run). Unset = admin routes disabled.
ADMIN_API_KEY=

# Optional API tuning — see README.md for defaults.
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=INFO

# .env is gitignored — never commit real keys.
