# Copy this file to .env and fill in your key to enable the optional LLM
# adjudication pass (pipeline/llm_adjudicate.py). Everything else in the
# pipeline and API works with no key at all — this only sharpens the
# handful of genuinely ambiguous hotel-matching cases.
#
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# .env is gitignored — never commit real keys.
